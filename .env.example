# CashBridge AI environment template
#
# Copy backend values into backend/.env
# Create frontend/.env.local with the VITE_ values only.
#
# This file must contain placeholders only.
# Never commit real credentials, tokens, or customer data.
# Use PayPal Sandbox credentials during the hackathon.

# ---------- Backend ----------
# Allowed browser origin for CORS. Must match the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (planned; not read by the backend yet)
# The service-role key is backend-only and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Sandbox
# The client ID and secret are required for GET /api/invoices.
# Use Sandbox app credentials only; the API base URL is fixed in code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI provider (planned; not read by the backend yet)
# Start with the mock adapter before adding a real provider.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# ---------- Frontend (planned) ----------
# Vite exposes these values to the browser, so they must never be secret.
VITE_API_BASE_URL=http://localhost:8000/api
